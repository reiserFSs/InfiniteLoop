import "../fonts/NotoSans-Regular.ttf";
import "../fonts/NotoSans-Medium.ttf";
import "../fonts/NotoSans-SemiBold.ttf";
import "../fonts/NotoSansSC-Regular.ttf";
import "../fonts/NotoSansSC-SemiBold.ttf";
import "../fonts/NotoSansJP-Regular.ttf";
import "../fonts/NotoSansJP-SemiBold.ttf";

component Plate inherits Rectangle {
    background: #0b0c0fd6;
}

component WinButton inherits Plate {
    in property <string> glyph;
    callback clicked;
    width: 32px;
    height: 28px;
    ta := TouchArea { clicked => { root.clicked(); } }
    background: ta.has-hover ? #1c1e24d6 : #0b0c0fd6;
    Path {
        width: 12px;
        height: 12px;
        viewbox-width: 12;
        viewbox-height: 12;
        stroke: #e9ebef;
        stroke-width: 1.4px;
        commands: root.glyph;
    }
}

component Row inherits HorizontalLayout {
    in property <string> key;
    in property <string> value;
    in property <bool> warn;
    min-height: 20px;
    Text { text: root.key; color: #9aa0aa; font-size: 13px; }
    Text {
        text: root.value;
        horizontal-alignment: right;
        color: root.warn ? #ffffff : #e9ebef;
        font-weight: root.warn ? 600 : 400;
        font-size: 13px;
    }
}

export component App inherits Window {
    in property <image> art;
    in property <string> ui-font: "Noto Sans";
    callback minimize();
    callback quit();
    callback drag();

    preferred-width: 1280px;
    preferred-height: 720px;
    no-frame: true;
    background: #0b0c0f;
    default-font-family: root.ui-font;
    default-font-size: 13px;

    Image {
        // 1px bleed on every side: no seam at fractional scale factors
        x: -1px;
        y: -1px;
        width: parent.width + 2px;
        height: parent.height + 2px;
        source: root.art;
        image-fit: cover;
    }

    // drag area: whole window background, controls sit on top
    TouchArea {
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) { root.drag(); }
        }
    }

    Plate {
        x: 20px;
        y: 16px;
        width: brand.preferred-width;
        height: 32px;
        brand := HorizontalLayout {
            padding-left: 10px;
            padding-right: 10px;
            spacing: 10px;
            Text { text: @tr("AscNet"); color: #e9ebef; font-size: 14px; font-weight: 600; vertical-alignment: center; }
            Text { text: @tr("Punishing: Gray Raven"); color: #9aa0aa; font-size: 12px; vertical-alignment: center; }
            VerticalLayout {
                alignment: center;
                Rectangle {
                    background: #e9ebef;
                    border-radius: 2px;
                    height: 19px;
                    width: ver.preferred-width + 12px;
                    ver := Text { text: "4.9"; color: #0b0c0f; font-size: 11px; font-weight: 600; }
                }
            }
        }
    }

    HorizontalLayout {
        x: parent.width - 12px - self.width;
        y: 12px;
        width: 68px;
        height: 28px;
        spacing: 4px;
        WinButton { glyph: "M2 6 L10 6"; clicked => { root.minimize(); } }
        WinButton { glyph: "M2 2 L10 10 M10 2 L2 10"; clicked => { root.quit(); } }
    }

    Plate {
        x: 20px;
        y: parent.height - 20px - self.height;
        width: 340px;
        height: l1.preferred-height;
        l1 := VerticalLayout {
            padding: 12px;
            padding-top: 12px;
            padding-left: 14px;
            padding-right: 14px;
            spacing: 0px;
            Text { text: @tr("Activity"); color: #9aa0aa; font-size: 11px; font-weight: 500; }
            Rectangle { height: 6px; }
            for item[i] in [
                { t: @tr("Client {} verified", "4.9.1"), h: "14:02" },
                { t: @tr("Launcher {} is up to date", "1.0.23"), h: "14:01" },
                { t: @tr("Game found in your Steam library"), h: "14:01" },
            ] : HorizontalLayout {
                height: 19px;
                spacing: 12px;
                Text { text: item.t; color: #e9ebef; overflow: elide; vertical-alignment: center; }
                Text { text: item.h; color: #7d838e; font-size: 12px; horizontal-alignment: right; vertical-alignment: center; }
            }
        }
    }

    VerticalLayout {
        x: parent.width - 20px - 340px;
        y: 0;
        width: 340px;
        height: parent.height - 20px;
        alignment: end;
        spacing: 8px;
        Plate {
            VerticalLayout {
                padding-left: 14px;
                padding-right: 14px;
                padding-top: 10px;
                padding-bottom: 10px;
                spacing: 2px;
                Row { key: @tr("Game"); value: @tr("EN (Global) {}", "4.9.1"); }
                Row { key: @tr("AscNet patch"); value: @tr("Not installed"); warn: true; }
                Row { key: @tr("Local server"); value: @tr("Stopped"); }
                Rectangle { height: 6px; }
                Text {
                    text: @tr("Set up builds the local server and patch. The first time takes a few minutes, and Windows may ask for permission.");
                    color: #9aa0aa;
                    font-size: 12px;
                    wrap: word-wrap;
                }
            }
        }
        Rectangle {
            height: 52px;
            border-radius: 2px;
            background: btn.has-hover ? #ffffff : #eef0f3;
            btn := TouchArea { }
            Text { text: @tr("Set up"); color: #0b0c0f; font-size: 16px; font-weight: 600; }
        }
        HorizontalLayout {
            alignment: end;
            Plate {
                width: lk.preferred-width;
                height: 28px;
                lk := HorizontalLayout {
                    padding: 4px;
                    padding-left: 14px;
                    padding-right: 14px;
                    Text { text: @tr("Game files"); color: #c9cdd4; font-size: 12px; horizontal-stretch: 0; vertical-alignment: center; }
                    Rectangle { width: 17px; Rectangle { x: 8px; y: 2px; width: 1px; height: 18px; background: #3a3e46; } }
                    Text { text: @tr("Settings"); color: #c9cdd4; font-size: 12px; vertical-alignment: center; }
                }
            }
        }
    }
}
