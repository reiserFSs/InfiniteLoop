msgstr "변경 후에는 서버와 게임을 다시 시작하세요."

msgid "Applying client mods…"
msgstr "클라이언트 모드 적용 중…"

msgid "Applied: {}. Restart the server and the game."
msgstr "적용됨: {}. 서버와 게임을 다시 시작하세요."

msgid "Applied: {}. Skipped: {}. Restart the server and the game."
msgstr "적용됨: {}. 건너뜀: {}. 서버와 게임을 다시 시작하세요."

msgid "Client mods are off and their files are removed. Restart the server and the game."
msgstr "클라이언트 모드가 꺼졌고 관련 파일이 제거되었습니다. 서버와 게임을 다시 시작하세요."

msgid "Couldn't change client mods: {}"
msgstr "클라이언트 모드를 변경하지 못했습니다: {}"

msgid "Choose an empty folder to download the game, or the folder of an existing install to verify, update or adopt it."
msgstr "게임을 다운로드할 빈 폴더를 선택하거나, 검사·업데이트·가져오기를 할 기존 설치 폴더를 선택하세요."

msgid "This folder isn't empty and has no PGR.exe. Choose an empty folder for a new install, or the folder of an existing game."
msgstr "이 폴더는 비어 있지 않고 PGR.exe도 없습니다. 새로 설치하려면 빈 폴더를, 기존 게임은 게임이 설치된 폴더를 선택하세요."

msgid "Can't read this folder: {}"
msgstr "이 폴더를 읽을 수 없습니다: {}"

msgid "Empty folder: a full {} client will be installed here."
msgstr "빈 폴더입니다. 여기에 {} 클라이언트 전체를 설치합니다."

msgid "An interrupted download was found here. It resumes from the files already verified."
msgstr "중단된 다운로드가 여기에 있습니다. 검사를 마친 파일부터 이어받습니다."

msgid "Inspecting the install…"
msgstr "설치 확인 중…"

msgid "Couldn't inspect the install: {}"
msgstr "설치를 확인하지 못했습니다: {}"

msgid "Stopping after the current file…"
msgstr "현재 파일까지 처리한 뒤 중지합니다…"

msgid "Select the folder that contains PGR.exe"
msgstr "PGR.exe가 있는 폴더를 선택하세요"

msgid "Select an empty folder for the game, or the folder of an existing game"
msgstr "게임을 내려받을 빈 폴더 또는 기존 게임 폴더를 선택하세요"

