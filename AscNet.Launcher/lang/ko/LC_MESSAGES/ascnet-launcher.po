msgid "The game is still running"
msgstr "게임이 아직 실행 중입니다"

msgid "Couldn't check the game"
msgstr "게임 상태를 확인하지 못했습니다"

msgid "No game folder"
msgstr "게임 폴더 없음"

msgid "Not the game folder"
