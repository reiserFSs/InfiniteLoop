msgid "Couldn't save settings"
msgstr "설정을 저장하지 못했습니다"

msgid "Couldn't stop the local server"
msgstr "로컬 서버를 중지하지 못했습니다"

msgid "Set up didn't finish"
msgstr "구성을 완료하지 못했습니다"

msgid "The game didn't start"
msgstr "게임이 시작되지 않았습니다"

msgid "Set up first"
msgstr "먼저 구성하세요"

msgid "The local server isn't available"
msgstr "로컬 서버를 사용할 수 없습니다"

msgid "Launcher update needed"
msgstr "런처 업데이트가 필요합니다"

msgid "Patch update needed"
msgstr "패치 업데이트가 필요합니다"

msgid "This game version isn't supported"
msgstr "지원되지 않는 게임 버전입니다"

