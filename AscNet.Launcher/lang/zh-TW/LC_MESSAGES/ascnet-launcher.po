msgstr "正在配置本機伺服器與修補程式…"

msgid "Restoring the original game files…"
msgstr "正在還原原始遊戲檔案…"

msgid "Starting the local server and the game…"
msgstr "正在啟動本機伺服器與遊戲…"

msgid "No mods yet. Set up refreshes the AscNet source and the mod list."
msgstr "尚無模組。配置會更新 AscNet 原始碼與模組清單。"

msgid "Client mods unavailable: {}"
msgstr "用戶端模組無法使用：{}"

msgid "Restart the server and the game after changes."
msgstr "變更後請重新啟動伺服器與遊戲。"

msgid "Applying client mods…"
msgstr "正在套用用戶端模組…"

